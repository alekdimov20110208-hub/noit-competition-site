# Placeholders ONLY. Configure these in the hosting secret manager, not Git.
NODE_ENV=production
HOST=0.0.0.0
PORT=10000
SERVE_FRONTEND=true
WEB_CONCURRENCY=1
REMINDER_WORKER_ENABLED=true
# Empty = ignore ALL forwarding headers for client identity. Add only verified
# exact ingress peer IPs after the provider trust/overwrite preflight in D2.
TRUSTED_PROXY_IPS=
DATABASE_URL=postgresql://REPLACE_RUNTIME_ROLE:REPLACE_PASSWORD@REPLACE_PRODUCTION_HOST:5432/REPLACE_PRODUCTION_DATABASE
DATABASE_TLS_MODE=verify-full
DATABASE_TLS_CA_FILE=REPLACE_WITH_MOUNTED_PROVIDER_CA_PATH
BETTER_AUTH_SECRET=REPLACE_WITH_NEW_PRODUCTION_ONLY_RANDOM_SECRET
BETTER_AUTH_URL=https://REPLACE_PUBLIC_HOST
PUBLIC_APP_URL=https://REPLACE_PUBLIC_HOST
EMAIL_MODE=resend
EMAIL_FROM=REPLACE_WITH_VERIFIED_DOMAIN_SENDER
RESEND_API_KEY=REPLACE_WITH_PRODUCTION_ONLY_SENDING_KEY
