# Non-secret placeholders only. Copy to server/.env and replace locally.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
# Remote databases and all production connections require verified TLS.
# Obtain the CA from a verified provider source; keep the file outside the repo.
# Relative paths resolve from the process working directory. No URL query options.
DATABASE_TLS_MODE=verify-full
DATABASE_TLS_CA_FILE=REPLACE_WITH_TRUSTED_CA_FILE_PATH
# Non-production loopback DB only: DATABASE_TLS_MODE=disable, omit the CA setting.
BETTER_AUTH_SECRET=REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_SECRET
BETTER_AUTH_URL=http://127.0.0.1:3001

# Deliberate local mode. Production requires resend and same public/auth origin.
EMAIL_MODE=disabled
PUBLIC_APP_URL=http://127.0.0.1:5173
EMAIL_FROM=REPLACE_WITH_VERIFIED_TRANSACTIONAL_SENDER
RESEND_API_KEY=REPLACE_WITH_SERVER_ONLY_RESTRICTED_API_KEY

# Optional: explicit DEVELOPMENT provisioning CLI only; not server startup.
BUDOGRAPH_ORGANIZER_EMAIL=REPLACE_ORGANIZER_EMAIL
BUDOGRAPH_ORGANIZER_PASSWORD=REPLACE_ORGANIZER_PASSWORD
BUDOGRAPH_ORGANIZER_NAME=REPLACE_ORGANIZER_NAME
BUDOGRAPH_MEMBER_EMAIL=REPLACE_MEMBER_EMAIL
BUDOGRAPH_MEMBER_PASSWORD=REPLACE_MEMBER_PASSWORD
BUDOGRAPH_MEMBER_NAME=REPLACE_MEMBER_NAME
