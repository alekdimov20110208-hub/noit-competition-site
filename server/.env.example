# Non-secret placeholders only. Copy to server/.env and replace locally.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgresql://REPLACE_USER:REPLACE_PASSWORD@REPLACE_HOST:5432/REPLACE_DATABASE
BETTER_AUTH_SECRET=REPLACE_WITH_A_CRYPTOGRAPHICALLY_RANDOM_SECRET
BETTER_AUTH_URL=http://127.0.0.1:3001

# Optional: explicit DEVELOPMENT provisioning CLI only; not server startup.
BUDOGRAPH_ORGANIZER_EMAIL=REPLACE_ORGANIZER_EMAIL
BUDOGRAPH_ORGANIZER_PASSWORD=REPLACE_ORGANIZER_PASSWORD
BUDOGRAPH_ORGANIZER_NAME=REPLACE_ORGANIZER_NAME
BUDOGRAPH_MEMBER_EMAIL=REPLACE_MEMBER_EMAIL
BUDOGRAPH_MEMBER_PASSWORD=REPLACE_MEMBER_PASSWORD
BUDOGRAPH_MEMBER_NAME=REPLACE_MEMBER_NAME
